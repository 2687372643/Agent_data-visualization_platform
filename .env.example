# ═══════════════════════════════════════════════
#  AI Agent Data Platform — 环境变量模板
#  复制此文件为 .env 并填入实际值
#  cp .env.example .env
# ═══════════════════════════════════════════════

# ── 应用基础 ──
APP_NAME=AI Agent Data Platform
DEBUG=true
VERSION=0.1.0

# ── CORS（开发环境用 *，生产环境填写具体域名）──
CORS_ORIGINS=["*"]

# ── 数据目录（默认在 backend/data/ 下）──
UPLOAD_DIR=backend/data/uploads
CHART_DIR=backend/data/charts
EXPORT_DIR=backend/data/exports
TEMP_DIR=backend/data/temp

# ── 文件上传限制 ──
MAX_UPLOAD_SIZE_MB=200
ALLOWED_EXTENSIONS=[".csv",".xlsx",".xls",".json",".tsv",".parquet"]

# ── PostgreSQL 数据库 ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/advp
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# ── Redis 缓存 ──
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT=5
REDIS_CACHE_TTL=300

# ── LLM / Agent ──
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=
LLM_MODEL_NAME=gpt-4o
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT=60

# ── 日志 ──
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s | %(levelname)-7s | %(name)s | %(message)s
LOG_USE_JSON=false
